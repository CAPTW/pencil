{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "agent_id",
    "created_at",
    "base_head",
    "claimed_paths",
    "claim_type",
    "expires_at",
    "release_state",
    "conflicting_claim",
    "owner_override"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "base_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "claimed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_type": {
      "const": "exclusive"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "release_state": {
      "enum": [
        "active",
        "released"
      ]
    },
    "conflicting_claim": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner_override": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
